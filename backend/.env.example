SECRET_KEY=replace-with-a-random-secret-at-least-50-characters
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Keep SQLite for local/staging. Set DEBUG=False and REQUIRE_POSTGRES=True
# only when the PostgreSQL deployment is ready.
REQUIRE_POSTGRES=False

DB_ENGINE=django.db.backends.sqlite3
# PostgreSQL values for final deployment:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=starlight
# DB_USER=starlight_app
# DB_PASSWORD=replace-with-a-database-secret
# DB_HOST=127.0.0.1
# DB_PORT=5432
DB_CONN_MAX_AGE=60

# Optional locally. Required for multi-worker production caching.
# REDIS_URL=redis://127.0.0.1:6379/1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
JWT_ACCESS_MINUTES=60
LOG_LEVEL=INFO
