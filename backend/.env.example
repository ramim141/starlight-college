# Local development example. Replace placeholders locally; never commit real credentials.
# স্থানীয় উন্নয়নের উদাহরণ। নিজের মেশিনে placeholder বদলান; আসল গোপন তথ্য commit করবেন না।
SECRET_KEY=<generate-a-random-secret-at-least-50-characters>
DEBUG=True
ALLOWED_HOSTS=<comma-separated-hostnames>

# Production requires PostgreSQL and REQUIRE_POSTGRES=True.
# Production-এ PostgreSQL এবং REQUIRE_POSTGRES=True আবশ্যক।
REQUIRE_POSTGRES=False
DB_ENGINE=<django.db.backends.sqlite3-or-django.db.backends.postgresql>
DB_NAME=<database-name>
DB_USER=<database-user>
DB_PASSWORD=<database-password>
DB_HOST=<database-host>
DB_PORT=<database-port>
DB_CONN_MAX_AGE=<connection-age-seconds>

# Optional locally; use a private authenticated Redis URL in production.
# স্থানীয়ভাবে ঐচ্ছিক; production-এ private authenticated Redis URL ব্যবহার করুন।
REDIS_URL=<redis-connection-url>
CORS_ALLOWED_ORIGINS=<comma-separated-https-or-local-origins>
CSRF_TRUSTED_ORIGINS=<comma-separated-https-origins>
SECURE_SSL_REDIRECT=<True-or-False>
SESSION_COOKIE_SECURE=<True-or-False>
CSRF_COOKIE_SECURE=<True-or-False>
SECURE_HSTS_SECONDS=<seconds>
JWT_ACCESS_MINUTES=<access-token-lifetime-minutes>
LOG_LEVEL=<DEBUG-INFO-WARNING-ERROR>
